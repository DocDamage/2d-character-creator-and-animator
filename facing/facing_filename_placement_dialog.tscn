[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://facing/facing_filename_placement_dialog.gd" id="1_dialog"]

[node name="FilenamePlacementDialog" type="AcceptDialog"]
size = Vector2i(640, 460)
title = "Batch Place from Filenames"
script = ExtResource("1_dialog")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 12.0
offset_right = -12.0
offset_bottom = -54.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_vertical = 3

[node name="HelpLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "One per line: asset_id | character_north.png\nThe longest exact current direction name in each filename is used. Preview must be clean before apply."
autowrap_mode = 2

[node name="EntriesInput" type="TextEdit" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
placeholder_text = "ast_hero_north | hero_north.png\nast_hero_east | hero_east.png"

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="PreviewButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Preview"

[node name="ApplyButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Apply Preview"
disabled = true

[node name="PreviewLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
text = "Enter one asset_id | filename pair per line, then preview."
